# Voorbeeldconfiguratie voor productie met docker compose.
# Kopieer naar .env (staat in .gitignore) en vervang alle VERANDER_MIJ-waarden.
# Sterk wachtwoord genereren: openssl rand -base64 24

# ---- Databank (MariaDB) ----
DB_NAME=lokaleondernemers
DB_USER=lokaleondernemers
DB_PASSWORD=VERANDER_MIJ
# Enkel gebruikt door de MariaDB-container.
DB_ROOT_PASSWORD=VERANDER_MIJ

# ---- Eerste beheerdersaccount ----
# Wordt enkel aangemaakt als er nog geen beheerder bestaat; wijzig het wachtwoord na de eerste login.
APP_ADMIN_EMAIL=admin@lokaleondernemers.shi.be
APP_ADMIN_WACHTWOORD=VERANDER_MIJ

# ---- Website ----
# Publiek adres van de site, gebruikt voor links in e-mails.
APP_BASIS_URL=https://lokaleondernemers.shi.be
APP_MAIL_AFZENDER=Lokale Ondernemers <mailer@shi.be>

# ---- SMTP ----
# Zolang SPRING_MAIL_HOST niet ingesteld is, worden e-mails niet verstuurd maar als HTML bewaard
# in het volume mail-voorbeelden. Laat deze regels dus in commentaar tot je een mailserver hebt
# (een lege SPRING_MAIL_HOST= telt ook als ingesteld).
#SPRING_MAIL_HOST=smtp.jouwprovider.be
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=noreply@lokaleondernemers.be
#SPRING_MAIL_PASSWORD=VERANDER_MIJ
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

SPRING_MAIL_HOST=smtp.forwardemail.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=mailer@shi.be
SPRING_MAIL_PASSWORD=2a0d8ff8d8411b0a33eb5fdc
SPRING_MAIL_FROM=
SPRING_MAIL_NOTIFY_TO=joeri@shi.be
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

